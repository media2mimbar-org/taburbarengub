{
  "name": "taburbarengub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "supabase gen types typescript --local | grep -v '^{\"_tag\":\"Error\"' > src/lib/types/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked | grep -v '^{\"_tag\":\"Error\"' > src/lib/types/database.types.ts",
    "db:diff": "supabase db diff --linked",
    "db:push": "supabase db push --linked",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/hauora-sans": "^5.2.5",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.34.0",
    "next": "16.2.11",
    "postcss": "^8.5.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22 <23"
  }
}
